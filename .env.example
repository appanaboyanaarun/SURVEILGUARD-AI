# =============================================================
# SurveilGuard AI - Complete Environment Configuration
# =============================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# In production, configure these via your hosting platform's environment settings.
# =============================================================

# ---------- Server & Environment ----------
DEBUG=false
DEVELOPMENT=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------- Public URLs ----------
# Public URL of backend API (no trailing slash)
BASE_URL=http://127.0.0.1:8000
# Public URL of frontend application (for SMS links, no trailing slash)
FRONTEND_URL=http://127.0.0.1:8000

# ---------- CORS Security ----------
# Comma-separated list of allowed origins or "*" for development
# Example: https://surveilguard.yourcompany.com,https://admin.yourcompany.com
CORS_ORIGINS=*

# ---------- Database ----------
# SQLite (default for development):
DATABASE_URL=sqlite:///data/surveillance_events.db
# PostgreSQL (for production):
# DATABASE_URL=postgresql://surveil_admin:SecurePass123!@localhost:5432/surveilguard_db

# ---------- Security & JWT Authentication ----------
# Strong secret key for token signing & HMAC validation
SECRET_KEY=replace-with-a-random-64-char-hex-secret-key-in-production
JWT_SECRET=replace-with-a-random-64-char-jwt-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SIGNED_URL_EXPIRE_MINUTES=120

# ---------- Live Detection & False Positive Control ----------
# Detection sensitivity (0.0 to 1.0, lower = more sensitive)
DETECTION_SENSITIVITY=0.35
# Minimum anomaly score threshold to trigger suspicious state
DETECTION_CONFIDENCE_THRESHOLD=0.60
# Number of seconds suspicious activity must persist before generating confirmed event
SUSPICIOUS_CONFIRMATION_SECONDS=1.5
# Duration (seconds) of automatic evidence recording clip
RECORDING_DURATION_SECONDS=8
WS_HEARTBEAT_INTERVAL=30

# ---------- Email Notifications (Google Apps Script HTTP API) ----------
EMAIL_ENABLED=true
EMAIL_PROVIDER=apps_script

# Google Apps Script Web App Deployment URL (exec endpoint)
# Obtained from Google Apps Script > Deploy > Manage deployments > Web app URL
# Format: https://script.google.com/macros/s/AKfycb.../exec
APPS_SCRIPT_WEB_APP_URL=YOUR_GOOGLE_APPS_SCRIPT_EXEC_URL

# Shared Webhook Secret Token (configured in Google Apps Script Script Properties)
APPS_SCRIPT_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# HTTP Request Timeout in seconds
APPS_SCRIPT_TIMEOUT_SECONDS=15

# Target Admin Email Addresses for Alert Notifications (comma-separated)
# ADMIN_EMAILS supports multiple admins; ADMIN_EMAIL remains a backward-compatible recipient.
ADMIN_EMAILS=admin1@company.com,admin2@company.com,admin3@company.com,admin4@company.com,admin5@company.com
ADMIN_EMAIL=admin1@company.com

# Public HTTPS URLs for remote application and secure signed evidence links.
# Keep localhost URLs for local development.
# For deployment, replace with your public application URL.
APP_BASE_URL=http://127.0.0.1:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Cooldown interval (in seconds) preventing email spam per camera
EMAIL_COOLDOWN_SECONDS=30

# ---------- Storage Management ----------
# Storage provider: local (development) or s3 (AWS/MinIO/Cloudflare R2/GCS S3-compatible)
STORAGE_PROVIDER=local
STORAGE_BUCKET=surveilguard-evidence
STORAGE_ACCESS_KEY=your_aws_or_s3_access_key
STORAGE_SECRET_KEY=your_aws_or_s3_secret_key
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1

# ---------- Firebase Cloud Messaging (Optional Mobile Push) ----------
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NOTIFICATION_COOLDOWN_SECONDS=30
